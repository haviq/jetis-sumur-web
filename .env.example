# Auth
AUTH_SECRET=
ADMIN_PIN=

# Google Sheets
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Public URLs
NUXT_PUBLIC_SITE_URL=https://jetis-sumur-web.vercel.app

# Multi-padukuhan / white-label
# tenantId must match an entry in server/utils/tenant.ts (or use env overrides below)
NUXT_PUBLIC_TENANT_ID=jetis-sumur

# Single-tenant env overrides (take priority over tenant registry values)
SITE_NAME=Jetis Sumur
SITE_TAGLINE=Pendataan Warga · DI Yogyakarta
SITE_ALAMAT=Sleman, DI Yogyakarta
SITE_RT_COUNT=4
SITE_LOGO_TEXT=JS

# Web Push / VAPID (opsional, untuk fitur notifikasi)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
