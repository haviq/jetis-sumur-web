# Admin PIN (min 8 chars recommended). Required in production.
ADMIN_PIN=

# Optional: public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets (optional — without these, app uses in-memory demo DB)
# Full guide: docs/SHEETS-SETUP.md
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key with \n newlines escaped in one line (or base64 PEM)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
